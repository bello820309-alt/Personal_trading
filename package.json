{
  "name": "personal-trading",
  "private": true,
  "version": "0.1.0",
  "description": "技術分析學堂：新手也看得懂的技術分析工具（0050、VOO、比特幣）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "fetch-extra": "tsx scripts/fetch-extra.ts",
    "icons": "node scripts/generate-icons.mjs",
    "lab": "tsx scripts/lab/cli.ts",
    "lab:browse": "node scripts/lab/browse.cjs"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "technicalindicators": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
